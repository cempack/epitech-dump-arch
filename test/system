#!/usr/bin/env bash
# Tests for lib/system.sh: the distribution, its package list and install
# hints, and the user-space tools (with stand-ins, no network).
set -uo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd)"
TEST_ROOT=$(mktemp -d)
trap 'rm -rf "$TEST_ROOT"' EXIT

# Only these basic commands, never the machine's own code, fd, nvim…: the
# tests must behave the same on a developer machine that has them all.
SYS_BIN="${TEST_ROOT}/sys-bin"
mkdir -p "$SYS_BIN"
for tool in sh bash env sed grep awk head tail cat wc mktemp rm mv cp ln mkdir chmod \
    basename dirname uname tr cut sort curl sha256sum; do
    path=$(command -v "$tool") && ln -sf "$path" "${SYS_BIN}/${tool}"
done
fail() { printf 'FAILED: %s\n' "$*"; exit 1; }
log() { :; }; ok() { printf 'ok: %s\n' "$*"; }; info() { :; }; warn() { printf 'warn: %s\n' "$*"; }
# shellcheck source=lib/system.sh
. "${REPO_DIR}/lib/system.sh"

[ "$(DUMP_OS=arch dump_os)" = arch ] || fail "DUMP_OS override"
case "$(dump_os)" in arch | ubuntu | other) ;; *) fail "dump_os: $(dump_os)" ;; esac
[ "$(DUMP_OS=arch install_hint github-cli gh)" = "sudo pacman -S --needed github-cli" ] || fail "arch hint"
[ "$(DUMP_OS=ubuntu install_hint github-cli gh)" = "sudo apt install gh" ] || fail "ubuntu hint"
DUMP_OS=ubuntu dump_packages | grep -qx epitech-cpool || fail "ubuntu list lacks epitech-cpool"
DUMP_OS=arch dump_packages | grep -qx criterion || fail "arch list lacks criterion"
[ -z "$(DUMP_OS=other dump_packages)" ] || fail "other has packages"

# ensure_user_tools with everything present but fd (Ubuntu's fdfind).
FAKE="${TEST_ROOT}/fake"
mkdir -p "$FAKE"
printf '#!/bin/sh\nexit 0\n' > "${FAKE}/nvim"
printf '#!/bin/sh\nexit 0\n' > "${FAKE}/uv"
printf '#!/bin/sh\nexit 0\n' > "${FAKE}/lazygit"
printf '#!/bin/sh\nexit 0\n' > "${FAKE}/fdfind"
printf '#!/bin/sh\necho "clang-format version 21.1.8"\n' > "${FAKE}/clang-format"
chmod +x "$FAKE"/*
out=$(HOME="${TEST_ROOT}/home" PATH="${FAKE}:${SYS_BIN}" ensure_user_tools) || fail "ensure_user_tools: $out"
[ -L "${TEST_ROOT}/home/.local/bin/fd" ] || fail "fd not linked to fdfind"

# An old clang-format is replaced through uv.
printf '#!/bin/sh\necho "clang-format version 18.1.3"\n' > "${FAKE}/clang-format"
cat > "${FAKE}/uv" <<EOF2
#!/bin/sh
echo "\$@" > "${TEST_ROOT}/uv.args"
printf '#!/bin/sh\necho "clang-format version 21.1.8"\n' > "${TEST_ROOT}/home/.local/bin/clang-format"
chmod +x "${TEST_ROOT}/home/.local/bin/clang-format"
EOF2
chmod +x "${FAKE}/uv"
out=$(HOME="${TEST_ROOT}/home" PATH="${TEST_ROOT}/home/.local/bin:${FAKE}:${SYS_BIN}" ensure_user_tools) \
    || fail "clang-format upgrade: $out"
grep -q "tool install --force clang-format>=21" "${TEST_ROOT}/uv.args" || fail "uv not asked for clang-format"
printf '%s\n' "$out" | grep -q 'clang-format 21.1.8 installed' || fail "no message: $out"

printf '%s\n' "System tests passed"
